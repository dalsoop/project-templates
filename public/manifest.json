{
  "manifest_version": 3,
  "name": "Infocutter Template",
  "description": "Strict MV3 template for selector-based display:none tools.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Infocutter",
    "default_popup": "public/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/index.js"],
      "run_at": "document_idle"
    }
  ]
}
